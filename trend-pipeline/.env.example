# ── Core ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
NEXT_PUBLIC_BASE_URL=https://yourdomain.com       # used in email download links & Pinterest pin URLs

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                        # required for webhook + build route (bypasses RLS)

# ── Stripe ───────────────────────────────────────────────────────────────────
# Get from: stripe.com → Developers → API keys
# Use sk_test_ / pk_test_ while testing, swap to sk_live_ / pk_live_ when going live
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Get from: stripe.com → Developers → Webhooks → Add endpoint
# Endpoint URL: https://yourdomain.com/api/webhook/stripe
# Event to listen for: checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# ── Resend (email) ───────────────────────────────────────────────────────────
# Get from: resend.com → API Keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=Hidden Library <noreply@yourdomain.com>

# ── OpenAI (embeddings for semantic search) ──────────────────────────────────
OPENAI_API_KEY=

# ── Pinterest ────────────────────────────────────────────────────────────────
# 1. Create an app at developers.pinterest.com
# 2. Request scopes: pins:write, boards:read
# 3. Generate an access token via OAuth 2.0 (expires every 30 days — refresh with refresh token)
# 4. Create one board per category on your Pinterest account
#    Board ID = the number in the board URL when you click Edit board
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_FINANCE=          # covers: money, personal finance, financial-health
PINTEREST_BOARD_ENTREPRENEURSHIP= # covers: business, entrepreneurship
PINTEREST_BOARD_CAREER=           # covers: career
PINTEREST_BOARD_PRODUCTIVITY=     # covers: productivity
PINTEREST_BOARD_AI_TOOLS=
PINTEREST_BOARD_HEALTH=
PINTEREST_BOARD_FITNESS=
PINTEREST_BOARD_CRYPTO=
PINTEREST_BOARD_REAL_ESTATE=
PINTEREST_BOARD_PARENTING=
PINTEREST_BOARD_MENTAL_HEALTH=
PINTEREST_BOARD_RELATIONSHIPS=
PINTEREST_BOARD_TRENDING=

# ── Optional ─────────────────────────────────────────────────────────────────
# Protects /api/trigger from unauthorized access
# Set the same value in Vercel env vars. Call: /api/trigger?secret=your_value
CRON_SECRET=
